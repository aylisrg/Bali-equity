# PostHog product analytics.
# Get the project API key in PostHog → Project Settings → Project API Key.
# The "phc_" prefixed key is safe to expose in the browser bundle.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Region host. Use eu.i.posthog.com for EU Cloud, us.i.posthog.com for US Cloud.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Google Maps JavaScript API (required for the /land catalog map).
# Create a key in Google Cloud console, enable "Maps JavaScript API",
# restrict it by HTTP referrer (equity-bali.com/*, *.vercel.app/*, localhost).
# Without the key the site builds fine and shows a "map unavailable" panel.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: cloud-styled Map ID for brand-matched dark map styling.
# Defaults to DEMO_MAP_ID (standard dark scheme) when unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
